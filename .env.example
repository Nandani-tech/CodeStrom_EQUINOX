# ==============================================================================
# ShopLedger - Environment Configuration
# ==============================================================================

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# When set, ShopLedger uses Gemini 2.5 Flash for multimodal receipt extraction
# and executive conversational financial reasoning.
# If omitted, ShopLedger gracefully falls back to built-in heuristic extraction
# and Python financial calculation engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (Default: 5002)
PORT=5002

# Flask Environment
FLASK_ENV=development
